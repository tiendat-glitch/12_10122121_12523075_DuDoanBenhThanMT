# Root Docker Compose configuration
FRONTEND_PORT=3000
FRONTEND_HOST_PORT=3000
BACKEND_PORT=8000
BACKEND_HOST_PORT=8000
AI_PORT=8001
AI_HOST_PORT=8001
API_URL=/api
BACKEND_UPSTREAM=http://backend:8000
AI_SERVICE_URL=http://ai-service:8001
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=ckd_ai
CORS_ORIGINS=http://localhost:3000
REQUEST_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO

# Optional public URLs used only for deployment/documentation.
PUBLIC_APP_URL=
PUBLIC_AI_URL=

